# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
collector/forex/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local databases (Postgres runs in Docker; never commit a db file)
*.db
*.db-journal
*.sqlite

# локальные личные инструкции/заметки по деплою — не коммитим
docs/local/

# vercel
.vercel

# .claude/worktrees (isolated git worktree created by EnterWorktree tool)
.claude/worktrees/
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
# Только корневая папка с логами: без ведущего слэша правило ловило и
# src/app/admin/logs — новые файлы страницы логов молча не попадали в индекс.
/logs/
log.txt
PERFORMANCE_AUDIT.md

# личные торговые отчёты, которые кладут сюда для отладки импорта
/test/
