# Forex collector service — тики Finnhub + история Twelve Data + свечи Dukascopy
# (металлы и таймфрейм 1m) → Postgres. Контекст сборки — ./collector/forex.
FROM node:24-alpine

WORKDIR /app

# Сначала зависимости (кэш слоёв).
COPY package.json ./
RUN npm install --omit=dev

# Исходники collector — маской, а не пофайлово: при пофайловом COPY новый
# модуль (dukascopy.mjs) не попал в образ, и контейнер падал на старте с
# ERR_MODULE_NOT_FOUND, хотя локально всё работало. Тесты лежат в __tests__/
# и под маску не подпадают.
COPY *.mjs ./

ENV NODE_ENV=production
ENV PORT=8081
EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/health >/dev/null 2>&1 || exit 1

CMD ["node", "index.mjs"]