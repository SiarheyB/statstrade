# --- Database ---
# PostgreSQL in both dev and production (dev/prod parity).
# Local dev: start the bundled container with `docker compose up -d db`,
# which matches the credentials below. In production point this at your
# managed/self-hosted Postgres instance.
DATABASE_URL="postgresql://tradestats:tradestats@localhost:5432/tradestats?schema=public"

# --- Auth ---
# Secret used to sign session JWTs (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# --- Encryption ---
# 32-byte key (hex) for AES-256-GCM encryption of exchange API secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-32-bytes-hex"

# --- Google sign-in (optional) ---
# OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Add your app origins to "Authorized JavaScript origins". No client secret needed.
# Leave unset to hide the "Continue with Google" button. Use the same value for both.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Google Drive (загрузка скриншотов сделок, опционально) ---
# Отдельный OAuth Client (Web application) для Drive API — НЕ тот же самый
# GOOGLE_CLIENT_ID, что используется для входа через Google (Identity
# Services): здесь нужен полноценный Authorization Code flow с client secret.
# Настройка (см. docs/SELF_HOSTING.md, раздел про Google Drive):
#   1. https://console.cloud.google.com/apis/credentials — создать проект (или
#      использовать существующий), включить "Google Drive API".
#   2. OAuth consent screen: тип External, scope добавлять не нужно вручную
#      (запрашивается кодом) — достаточно заполнить название приложения.
#      Пока приложение не прошло верификацию Google — добавить себя и
#      пользователей в "Test users".
#   3. Credentials → Create Credentials → OAuth client ID → Web application.
#      Authorized redirect URIs: https://<ваш-домен>/api/integrations/google-drive/callback
#   4. Скопировать Client ID и Client Secret сюда.
# Если переменные не заданы — кнопка подключения Google Drive скрыта, фича
# загрузки скриншотов недоступна (не ломает остальное приложение).
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI=""

# --- Яндекс.Диск (загрузка скриншотов сделок, опционально, второй провайдер) ---
# Если у пользователя подключены и Google Drive, и Яндекс.Диск — новые
# загрузки идут в Google Drive (см. lib/integrations/cloudStorage.ts).
# Настройка (см. docs/SELF_HOSTING.md, раздел про Яндекс.Диск):
#   1. https://oauth.yandex.ru/client/new — создать приложение.
#   2. Платформы: "Веб-сервисы". Redirect URI:
#      https://<ваш-домен>/api/integrations/yandex-disk/callback
#   3. Доступ (Scopes): "Яндекс.Диск REST API: доступ к папке приложения"
#      (cloud_api:disk.app_folder) — НЕ выдавайте доступ ко всему диску.
#   4. Скопировать ID и Пароль (Client ID / Client Secret) сюда.
# Если переменные не заданы — кнопка подключения Яндекс.Диска скрыта.
YANDEX_DISK_CLIENT_ID=""
YANDEX_DISK_CLIENT_SECRET=""
YANDEX_DISK_REDIRECT_URI=""

# --- Cloudflare Turnstile (капча на регистрации, бесплатно, опционально) ---
# Создай виджет: https://dash.cloudflare.com → Turnstile → Add site.
# Site Key → NEXT_PUBLIC_TURNSTILE_SITE_KEY (публичный), Secret Key → TURNSTILE_SECRET.
# Пока не заданы — капча выключена, работают rate-limit + honeypot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# --- Scheduler ---
# Secret required to call the cron sync endpoint (/api/cron/sync).
CRON_SECRET="change-me"
# In-process scheduler ("true"/"false"). Keep "true" only for local dev with a
# long-running `next dev`. On serverless (Vercel) AND on the self-hosted server
# set "false" and trigger /api/cron/sync via an external cron — on the home
# server that's the host's system crontab (see docs/SELF_HOSTING.md, step 9.1).
ENABLE_SCHEDULER="true"

# Enable detailed logs for the Forex/MT import endpoint (POST /api/accounts/[id]/import)
# Set to "true" to see start/stop and per‑step logs in Docker/server console.
ENABLE_IMPORT_LOGS="true"

# --- Admin panel ---
# Comma-separated list of admin e-mails. These users get access to /admin.
ADMIN_EMAILS=""
# Collector service URL + Bearer token for its protected GET /metrics endpoint
# (admin "Order map" section). The token is one you generate yourself, e.g.
#   openssl rand -hex 32
# and it MUST match the collector's COLLECTOR_METRICS_TOKEN (passed to the
# collector service in docker-compose.prod.yml). If empty, the section falls back
# to Postgres aggregates only (no live feed status).
#
# Prod (docker-compose.prod.yml): app & collector share the compose network, so
#   COLLECTOR_URL=http://collector:8080   (this is already the compose default)
# Local: if you run the collector yourself, COLLECTOR_URL=http://localhost:8080
COLLECTOR_URL=""
COLLECTOR_METRICS_TOKEN=""
# forex-collector's GET /health endpoint (admin "Forex" section) — unlike the
# crypto collector, no Bearer token needed, /health only exposes non-sensitive
# counters. Prod default (compose): http://forex-collector:8081
# Local: FX_COLLECTOR_URL=http://localhost:8081
FX_COLLECTOR_URL=""

# --- Collector (orderbook / orderflow) ---
# Эти переменные пробрасываются в docker-compose.yml и docker-compose.prod.yml
# в контейнер collector через ${OB_...:-default} подстановку.
#
# Какие пары собирать (через запятую).
# OB_SYMBOLS="BTCUSDT,ETHUSDT"
# OB_EXCHANGES="binance-futures,binance-spot"
#
# Как часто писать снапшот стакана (мс). Чем чаще — тем точнее график,
# но больше данных. 2000 = каждые 2 секунды.
# OB_SNAPSHOT_MS=2000
#
# Глубина стакана в % от mid-цены. 0.02 = 2% вверх и вниз.
# OB_DEPTH_PCT=0.02
#
# Минимальный нотионал для фильтра шума в $.
# OB_NOISE_MIN_NOTIONAL=50000
#
# Порог крупной сделки в $.
# OB_BIG_NOTIONAL=100000
#
# ═══════════════════════════════════════════════════════════════════════════════
# СРОК ХРАНЕНИЯ (RETENTION) — через сколько дней данные удаляются автоматически
# ═══════════════════════════════════════════════════════════════════════════════
# OB_RETENTION_DAYS — срок хранения СЫРЫХ СНАПШОТОВ СТАКАНА (таблица ObSnapshot).
#   Каждый снапшот — это все ценовые уровни стакана на момент записи. Это
#   самая тяжёлая таблица: миллионы строк. Хранить её долго = много места на
#   диске. Рекомендуется 7–14 дней — для heatmap и B/A графиков достаточно,
#   т.к. они читают rollup (предагрегированные минутные бакеты).
#   По умолчанию: 14 дней (в docker-compose) / 7 дней (в самом collector).
# OB_RETENTION_DAYS=14
#
# OB_TRADE_RETENTION_DAYS — срок хранения ИСТОРИИ СДЕЛОК, ФУТПРИНТА И КРУПНЫХ
#   ОРДЕРОВ (таблицы ObTrade, ObFootprint, ObBigTrade).
#   Дельта, футпринт и крупные сделки — это «история карты ордеров»: они
#   показывают, кто и как торговал. Данные легче снапшотов (одна строка = одна
#   сделка, а не все уровни стакана). Поэтому их можно хранить дольше — для
#   анализа трендов и поиска крупных игроков за недели/месяцы.
#   По умолчанию: 30 дней (в docker-compose и в самом collector).
#   Если хочешь хранить снапшоты 7 дней, а историю сделок 90 — поставь:
#     OB_RETENTION_DAYS=7
#     OB_TRADE_RETENTION_DAYS=90
#   Если OB_TRADE_RETENTION_DAYS не задан — используется OB_RETENTION_DAYS.
# OB_TRADE_RETENTION_DAYS=30
#
# ROLLUP_RETENTION_DAYS — срок хранения АГРЕГИРОВАННЫХ ДАННЫХ (ObSnapshotRollup,
#   ObRollupBucket). Эти таблицы легче сырых, поэтому можно хранить дольше —
#   например, год, для долгосрочного анализа карты ордеров. По умолчанию 365 дней.
# ROLLUP_RETENTION_DAYS=365
#
# OB_CANDLE_RETENTION_DAYS — срок хранения СВЕЧЕЙ OHLCV (таблица ObCandle).
#   Свечи строятся из Binance klines API — это лёгкая таблица, можно хранить
#   долго (год+). Коллектор чистит старые свечи раз в час по этому параметру.
#   По умолчанию: 365 дней (в docker-compose.yml).
# OB_CANDLE_RETENTION_DAYS=365

# --- Finnhub API (форекс, основной источник) ---
# API-ключ для Finnhub — бесплатный WebSocket с тиками (сделками) без лимита
# на число сообщений (лимит только на кол-во подписанных символов, до 50).
# forex-collector сам агрегирует тики в свечи 5m/15m/1h/4h/1d/1w.
# Получить: https://finnhub.io/register (бесплатно). Доступен из РБ.
# БЕЗ ЭТОГО forex-collector не запустится.
FINNHUB_API_KEY=""

# --- Twelve Data API (форекс, бэкафилл истории + fallback) ---
# API-ключ для Twelve Data — REST API, используется только для загрузки
# истории свечей при старте и редкого fallback-догона (на случай обрыва
# Finnhub WS). Основной источник реального времени — Finnhub, не этот ключ.
# Получить: https://twelvedata.com/apikey (бесплатно, 800 запросов/день).
# Не обязателен: без него коллектор запустится, но истории до первых
# накопленных тиков не будет.
TWELVEDATA_API_KEY=""

# --- Forex collector ---
# Какие пары собирает forex-collector (со слэшем, как в UI).
# По умолчанию: EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,NZD/USD,EUR/JPY,GBP/JPY
# FX_SYMBOLS="EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,NZD/USD"
#
# Как часто сбрасывать в БД текущие (открытые) свечи, собранные из тиков Finnhub (с).
# По умолчанию 15 сек.
# FX_FLUSH_INTERVAL_SEC=15
#
# Как часто Twelve Data досогласовывает историю (fallback-догон), сек.
# По умолчанию 900 = 15 минут. Не влияет на реальное время — только подстраховка.
# FX_FALLBACK_INTERVAL_SEC=900
#
# Сколько дней хранить свечи форекс (FxCandle). По умолчанию 365 дней.
# FX_CANDLE_RETENTION_DAYS=365
