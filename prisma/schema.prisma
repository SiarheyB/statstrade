// Prisma schema for the trader-statistics app.
// PostgreSQL in both dev (local Docker) and production — dev/prod parity.
// Monetary values use Float (double precision): fine for crypto prices/PnL and
// keeps the JS analytics engine simple. Switch to Decimal if you ever need
// exact accounting-grade arithmetic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  password             String? // bcrypt hash (null for Google-only accounts)
  googleId             String?               @unique // Google "sub" when linked to a Google account
  name                 String?
  createdAt            DateTime              @default(now())
  // Last time ANY authenticated request came from the user (throttled write,
  // ~once per 5 min) — including background polls of an open tab. Drives
  // adaptive auto-sync backoff: idle users sync less often.
  lastSeenAt           DateTime?
  // Last time the user was actually AT the screen: visible tab + interaction in
  // the last few minutes (маячок PresenceBeacon → /api/presence). Это и есть
  // «онлайн» в админке — фоновый опрос открытой вкладки его не поднимает.
  lastActiveAt         DateTime?
  // JSON arrays of user-configurable dropdown options for trade annotations.
  entryPointOptions    String?
  entryTypeOptions     String?
  mistakeOptions       String?
  patternOptions       String?
  // Two-factor auth (TOTP / Google Authenticator). Secret is AES-256-GCM
  // encrypted at rest; only active once the user confirms a code.
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  // Версия сессионного токена: JWT с меньшей версией недействителен. Инкремент
  // при смене пароля отзывает все выданные ранее cookie (см. lib/auth.ts).
  tokenVersion         Int                   @default(0)
  accounts             ExchangeAccount[]
  annotations          TradeAnnotation[]
  playbooks            Playbook[]
  shareLinks           ShareLink[]
  drawings             UserDrawing[]
  cloudStorageAccounts CloudStorageAccount[]
  gamePlayer           GamePlayer?
}

// Audit trail of admin-panel actions (delete user, force-sync, reset 2FA, etc.).
// Admins are defined by ADMIN_EMAILS (no role column), so the actor is stored by
// id + email snapshot. Append-only; surfaced in /admin/audit.
model AdminAudit {
  id          String   @id @default(cuid())
  actorId     String // admin user id
  actorEmail  String // snapshot of admin email at action time
  action      String // e.g. user.delete | account.sync | account.reset | user.reset2fa | content.refresh
  targetType  String? // user | account | content
  targetId    String? // affected entity id (when applicable)
  targetLabel String? // human-readable target (email / exchange label / feed)
  detail      String? // optional extra context
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Manual, user-supplied annotations attached to a reconstructed round-trip
// trade. Trades have no DB row of their own, so they are referenced by a
// stable composite key (account + symbol + market + entry timestamp).
model TradeAnnotation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeKey       String
  entryPoint     String? // ТВХ (точка входа)
  entryType      String? // тип входа
  mistake        String? // ошибка в сделке
  pattern        String? // паттерн
  stopLoss       Float? // цена стоп-лосса (для маркера на графике)
  note           String?
  // Скриншот сделки, загруженный пользователем в СВОЁ облако (Google Drive).
  // Мы храним только публичную ссылку — не сам файл. imageProvider/imageFileId
  // нужны для UI (иконка сервиса) и потенциальной переустановки прав доступа.
  imageUrl       String?
  imageProvider  String? // "google_drive"
  imageFileId    String? // id файла в облаке провайдера
  // Публичная ссылка на страницу просмотра файла — работает БЕЗ входа в
  // приложение (в отличие от imageUrl, который для yandex_disk указывает на
  // наш защищённый сессией прокси /api/trade-images/view, нужный для показа
  // картинки внутри UI через <img src>). Для google_drive imageUrl уже сам
  // по себе публичный, так что тут дублируется то же значение. Используется
  // в CSV-экспорте сделок.
  imagePublicUrl String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, tradeKey])
  @@index([userId])
}

// OAuth-подключение облачного хранилища пользователя (Google Drive), через
// которое загружаются скриншоты сделок. Токены шифруются AES-256-GCM тем же
// ENCRYPTION_KEY, что и секреты ExchangeAccount (см. lib/crypto.ts) — мы НЕ
// храним и не видим файлы пользователя, только используем узкий OAuth-scope
// drive.file (доступ лишь к файлам, созданным этим приложением).
model CloudStorageAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "google_drive"
  accessToken  String // encrypted (AES-256-GCM)
  refreshToken String // encrypted (AES-256-GCM)
  expiresAt    DateTime
  accountEmail String? // для отображения "подключено как you@gmail.com"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// A connected exchange account (one API key) belonging to a user.
model ExchangeAccount {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange            String // binance | bybit | okx | mt4 | mt5 | manual
  label               String
  // Data source. "exchange" = CCXT API sync; mt4/mt5/manual = file-imported
  // round-trips (no API keys, no sync).
  source              String          @default("exchange")
  accountCurrency     String          @default("USD") // account currency for imported (forex) trades
  assetClass          String? // null = crypto | "forex"
  apiKey              String? // AES-256-GCM encrypted (null for imported/manual accounts)
  apiSecret           String? // AES-256-GCM encrypted (null for imported/manual accounts)
  passphrase          String? // AES-256-GCM encrypted (OKX requires a passphrase)
  marketType          String          @default("both") // spot | futures | both
  demoTrading         Boolean         @default(false) // Bybit Demo Trading key -> use demo API host
  balance             Float? // last fetched account balance/equity in USDT (deposit)
  balanceAt           DateTime? // when balance was last fetched
  capital             Float? // user-set capital for this account (Overview), overrides balance
  createdAt           DateTime        @default(now())
  lastSyncAt          DateTime?
  syncStatus          String          @default("idle") // idle | syncing | error
  syncError           String?
  // Background auto-sync on a schedule.
  autoSync            Boolean         @default(false)
  syncIntervalMinutes Int             @default(60)
  // Chunked background import progress. A scan walks a persisted task plan
  // (one task per trading pair on per-symbol exchanges like Binance) in
  // time-bounded chunks so it survives serverless timeouts.
  syncPhase           String? // null | "full" | "incremental"
  syncPlan            String? // JSON array of "kind|symbol" tasks for the active scan
  syncCursor          Int             @default(0) // index of the next task to process
  syncTotal           Int             @default(0) // total tasks in the active scan
  syncImported        Int             @default(0) // fills imported so far in the active scan
  fullSyncAt          DateTime? // when the last full (all-pairs) scan completed
  // Когда материализованные сделки (Trade) в последний раз пересобраны целиком
  // для этого аккаунта. NULL = ещё ни разу → /api/stats пересоберёт при первом
  // обращении (бэкафилл после деплоя / legacy-аккаунты).
  tradesRebuiltAt     DateTime?
  fills               Fill[]
  importedTrades      ImportedTrade[]
  trades              Trade[]
  tradeHourly         TradeHourly[]

  @@index([userId])
}

// Материализованный round-trip (закрытая сделка), реконструированный из филлов.
// Пересобирается ИНКРЕМЕНТНО: после вставки новых филлов пересчитываются только
// затронутые группы (account+symbol+market) — см. lib/analytics/materialize.ts.
// Раньше /api/stats реконструировал сделки из всех филлов юзера на каждый
// cache-miss; теперь это обычный индексированный SELECT.
model Trade {
  // Стабильный ключ = accountId:symbol:market:entryMs — совпадает с
  // TradeAnnotation.tradeKey, аннотации клеятся по нему.
  id          String          @id
  accountId   String
  account     ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol      String
  base        String
  quote       String
  market      String // spot | swap | future
  exchange    String
  side        String // long | short
  entryTime   DateTime
  exitTime    DateTime
  qty         Float // peak position size (base)
  entryPrice  Float // average entry
  exitPrice   Float // average exit
  grossPnl    Float
  fees        Float
  netPnl      Float
  returnPct   Float
  fillCount   Int
  result      String // win | loss | breakeven
  // MFE/MAE — «лучшая возможная цена» за время удержания и максимальная
  // просадка, в % от цены входа. У ЗАКРЫТОЙ сделки они неизменны, поэтому
  // считаются один раз и сохраняются (см. lib/analytics/mfe.ts). Раньше это
  // считалось в БРАУЗЕРЕ: на каждый клик «Посчитать» страница «Аналитика»
  // делала до maxTrades запросов к публичному API биржи за свечами и ничего
  // не сохраняла — следующий клик повторял всё заново.
  mfePct      Float? // максимальный ход в пользу сделки, % от входа
  maePct      Float? // максимальная просадка, % от входа
  capturedPct Float? // сколько из благоприятного хода забрал реальный выход
  bestPrice   Float? // цена «идеального» выхода
  mfeAt       DateTime? // когда посчитано; NULL = ещё нет данных
  // Счётчик неудачных попыток (биржа недоступна, свечи не совпали с ценами
  // сделки). Нужен, чтобы не долбить биржу бесконечно из-за делистнутой пары:
  // после MFE_MAX_ATTEMPTS сделка перестаёт попадать в очередь.
  mfeAttempts Int             @default(0)
  // R-multiple — посчитан и сохранён один раз (см. lib/analytics/rr.ts),
  // а не при каждом запросе /api/stats. Пересчитывается точечно при: ребилде
  // сделок аккаунта, правке stopLoss в TradeAnnotation, смене риск-профиля.
  rr          Float?

  @@index([accountId, exitTime])
  @@index([accountId, symbol, market])
}

// Почасовой агрегат по закрытым сделкам аккаунта — одна строка на
// (аккаунт, час). Считается ОДИН РАЗ при изменении сделок (см.
// lib/analytics/hourly.ts), а не на каждый запрос: раньше риск-менеджер и
// дашборд тянули все сделки за период и складывали их в Node.
//
// Почему час, а не день. Все экраны показывают время в таймзоне пользователя
// (настройка ts_timezone, фиксированный сдвиг вида UTC+3). Дневной агрегат в
// UTC для этого не годится: один UTC-день попадает на два локальных, и
// пересобрать его сложением готовых строк нельзя. Часовые бакеты складываются
// в локальный день при чтении для любого сдвига, кратного часу — а список
// таймзон в приложении состоит ровно из таких (см. lib/timezone.ts).
//
// Час = начало часа exitTime в UTC. День сделки везде определяется по ВЫХОДУ
// (P&L фиксируется при закрытии) — так же считают риск-лимиты, Metrics.daily,
// кривая капитала и «Календарь».
//
// Агрегат покрывает и crypto (Trade), и импортированные форекс/MT-сделки
// (ImportedTrade) — обе таблицы сворачиваются в одни и те же строки.
model TradeHourly {
  accountId   String
  account     ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hour        DateTime        @db.Timestamp(3) // начало часа exitTime в UTC
  trades      Int             @default(0)
  wins        Int             @default(0)
  losses      Int             @default(0)
  netPnl      Float           @default(0)
  grossProfit Float           @default(0) // Σ netPnl прибыльных сделок
  grossLoss   Float           @default(0) // Σ |netPnl| убыточных (положительное число)
  fees        Float           @default(0)
  // R-мультипликаторы: суммы уже сохранённого Trade.rr / ImportedTrade.rr —
  // не пересчитываются (см. lib/analytics/rr.ts). netR = winR + lossR.
  winR        Float           @default(0) // Σ положительных rr
  lossR       Float           @default(0) // Σ отрицательных rr (отрицательное число)
  rTrades     Int             @default(0) // сколько сделок часа имеют посчитанный rr
  updatedAt   DateTime        @updatedAt

  @@id([accountId, hour])
  @@index([hour])
}

// A closed round-trip imported from a MetaTrader 4/5 report (or entered
// manually). Unlike crypto trades these are NOT reconstructed — the money
// (profit / swap / commission) is taken as-is from the broker, in account
// currency. The stats layer merges these with reconstructed crypto trades.
model ImportedTrade {
  id           String          @id @default(cuid())
  accountId    String
  account      ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source       String // mt4 | mt5 | manual
  externalId   String // ticket (MT4) / position id (MT5) — for dedup
  symbol       String // EURUSD, XAUUSD, US30 ...
  base         String
  quote        String
  market       String          @default("forex")
  side         String // long | short
  lots         Float
  qty          Float // lots * contractSize (base units)
  contractSize Float           @default(100000)
  entryTime    DateTime
  exitTime     DateTime
  entryPrice   Float
  exitPrice    Float
  stopLoss     Float?
  takeProfit   Float?
  commission   Float           @default(0) // account currency
  swap         Float           @default(0) // account currency
  grossProfit  Float // broker profit before swap/commission, account currency
  netPnl       Float // grossProfit + swap - commission
  pips         Float?
  currency     String          @default("USD") // account currency at import time
  comment      String?
  importedAt   DateTime        @default(now())
  importBatch  String? // id of the upload batch (for rollback)
  // R-multiple — та же схема, что у Trade.rr (см. lib/analytics/rr.ts).
  rr           Float?

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([accountId, exitTime])
}

// A single execution (fill) imported from an exchange. Round-trip trades are
// reconstructed from these on the fly by the analytics layer.
model Fill {
  id           String          @id @default(cuid())
  accountId    String
  account      ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  exchange     String
  tradeId      String // exchange-side fill/trade id
  orderId      String?
  symbol       String // e.g. BTC/USDT
  base         String // BTC
  quote        String // USDT
  market       String // spot | swap | future
  side         String // buy | sell
  price        Float
  amount       Float // base amount filled
  cost         Float // quote cost = price * amount
  fee          Float           @default(0) // fee amount
  feeCurrency  String?
  realizedPnl  Float? // exchange-provided realized pnl, when available (futures)
  takerOrMaker String?
  timestamp    DateTime
  createdAt    DateTime        @default(now())

  @@unique([accountId, tradeId, symbol])
  @@index([accountId])
  @@index([accountId, timestamp])
  @@index([accountId, symbol])
}

// Aggregated taker-trade volume per snapshot interval — written by the collector
// from the aggTrades stream. Drives the delta / cumulative-delta panel under the
// orderbook heatmap. buyVol/sellVol are aggressor base volumes.
// NB: в БД таблица партиционирована по дням (PARTITION BY RANGE (t), см.
// миграцию partition_ob_tables) и НЕ имеет PK — @id здесь только для типизации
// клиента Prisma. Дневные партиции создаёт collector (ob_ensure_partitions),
// чистка = DROP партиции (ob_drop_partitions_before) вместо DELETE.
//
// «НЕ имеет PK» стало правдой только в миграции drop_unused_partition_pk: до
// неё PK (id, t) стоял на каждой партиции с idx_scan = 0 — по id эти таблицы
// не читает никто. Колонка id и её sequence остались: 8 байт на строку против
// 24+ у индексной записи, а NULL в ней сломал бы чтение модели с BigInt @id.
model ObTrade {
  id       BigInt   @id @default(autoincrement())
  symbol   String
  exchange String
  t        DateTime @db.Timestamptz(3)
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)
  // Сколько ПЕЧАТЕЙ попало в этот тик. Строка агрегирует все сделки интервала,
  // поэтому COUNT(*) по таблице даёт частоту опроса коллектора, а не активность
  // рынка — «скорость ленты» должна суммировать именно это поле.
  trades   Int      @default(0)

  @@index([symbol, exchange, t]) // выборка exchange="all" идёт по префиксу symbol
}

// Traded volume per price bin per snapshot — written by the collector from the
// trade stream. Drives the footprint/cluster overlay (buy vs sell volume at each
// price level inside a candle).
// NB: партиционирована по дням, без PK в БД (см. ObTrade / partition_ob_tables).
model ObFootprint {
  id       BigInt   @id @default(autoincrement())
  symbol   String
  exchange String
  t        DateTime @db.Timestamptz(3)
  price    Float
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)

  @@index([symbol, exchange, t])
}

// Large market trades (taker prints above a notional threshold) — written by the
// collector from the trade stream. Drives the "large orders" feed.
// NB: партиционирована по дням, без PK в БД (см. ObTrade / partition_ob_tables).
model ObBigTrade {
  id       BigInt   @id @default(autoincrement())
  symbol   String
  exchange String
  t        DateTime @db.Timestamptz(3)
  price    Float
  qty      Float
  side     String // buy | sell

  @@index([symbol, exchange, t])
}

// OHLCV candles collected from Binance REST API by the collector service.
// One row per (symbol, exchange, interval, open_time). Stored pre-computed for
// all timeframes used by the orderflow chart (5m, 15m, 1h, 4h, 12h, 1d, 1w).
// Much smaller than orderbook data — regular table, not partitioned.
// Pruned by the collector via DELETE on t older than CANDLE_RETENTION_DAYS.
model ObCandle {
  symbol   String
  exchange String // binance-futures or binance-spot
  interval String // 5m, 15m, 1h, 4h, 12h, 1d, 1w
  t        DateTime @db.Timestamptz(3) // candle open time (UTC)
  o        Float // open price
  h        Float // high price
  l        Float // low price
  c        Float // close price
  v        Float    @default(0) // volume in base asset

  @@id([symbol, exchange, interval, t])
  // Дубля первичного ключа здесь НЕТ намеренно: @@index с теми же колонками в
  // том же порядке не обслуживает ни одного запроса, которого не обслужил бы
  // PK, а весит столько же (на ObCandle это было 49 МБ при 96 МБ данных) и
  // стоит лишней работы на каждой вставке. Снят миграцией candle_index_diet —
  // то же, что orderflow_index_diet сделала для Ob*Rollup.
  // Для подсчёта числа инструментов на главной: DISTINCT symbol по интервалу.
  @@index([interval, symbol])
  // Поиск самой старой свечи при бэкафилле: MIN(t) по всей таблице.
  @@index([t])
}

// Сторожевые метки ретеншна для коллектора. Каждая запись хранит момент
// начала отсчёта срока хранения данных (epochStart) для одной категории:
// "snapshot", "trade" или "candle". При первом запуске коллектора epochStart
// устанавливается в now(), после каждой очистки (pruneOld) сдвигается на now().
// Счётчик до очистки в админке считается как:
//   cleanupInMs = (epochStart + retentionDays * 86400000) - now()
// Это даёт внятный отсчёт независимо от бэкфилла — например, свечи 365 дн
// на системе возрастом 5 дней покажут «через 360 д», а не «очистка сейчас».
model RetentionEpoch {
  id            String   @id @default(cuid())
  category      String   @unique // "snapshot" | "trade" | "candle"
  epochStart    DateTime @map("epoch_start") @db.Timestamptz(3)
  retentionDays Int      @map("retention_days")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("RetentionEpoch")
}

// UserDrawing — created by direct DB migration, not yet in tracked schema.
// Added here to resolve Prisma migration drift. Types match the existing DB columns.
model UserDrawing {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  exchange  String
  toolType  String
  points    String
  color     String    @default("#38bdf8")
  lineWidth Int       @default(2)
  fillColor String?
  label     String?
  // Показывать ли цену уровня/луча ярлыком на ценовой шкале (см.
  // components/DrawingOverlay.tsx). По умолчанию да: рисуя горизонталь,
  // трейдер обычно как раз и хочет видеть её цену.
  showPrice Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamp
  updatedAt DateTime  @updatedAt @db.Timestamp
  deletedAt DateTime? @db.Timestamp

  @@index([userId, symbol, exchange])
  @@map("UserDrawing")
}

// UserLevel — created by direct DB migration, not yet in tracked schema.
// Added here to resolve Prisma migration drift. Types match the existing DB columns.
model UserLevel {
  id        String    @id
  userId    String
  symbol    String
  exchange  String
  price     Float
  type      String
  label     String?
  strength  Int       @default(1)
  timeframe String?
  color     String?
  createdAt DateTime  @default(now()) @db.Timestamp
  updatedAt DateTime  @updatedAt @db.Timestamp
  deletedAt DateTime? @db.Timestamp

  @@unique([userId, symbol, exchange, price, type])
  @@index([userId, symbol, exchange])
  @@map("UserLevel")
}

// Per-user per-exchange favourite tickers for the liquidation map. Sort order
// is implicit (reverse chronological — latest addition first).
model FavouriteTicker {
  id        String   @id @default(cuid())
  userId    String
  exchange  String
  symbol    String
  createdAt DateTime @default(now()) @db.Timestamp

  @@unique([userId, exchange, symbol])
  @@index([userId, exchange])
  @@map("FavouriteTicker")
}

// Aggregated crypto news from external RSS sources. Global (not per-user);
// Orderbook heatmap snapshots — written by the standalone collector service
// (collector/), one row per non-empty price bin per snapshot. Global market
// data (not per-user). Read by /api/orderflow to render the limit-order heatmap.
// High-volume table: keep it lean and prune by retention (see collector).
// NB: партиционирована по дням, без PK в БД (см. ObTrade / partition_ob_tables).
model ObSnapshot {
  id       BigInt   @id @default(autoincrement())
  symbol   String // BTCUSDT
  exchange String // binance-futures
  t        DateTime @db.Timestamptz(3) // snapshot timestamp (absolute instant, UTC)
  price    Float // price-bin center
  bidVol   Float    @default(0) // aggregated bid size in the bin (base units)
  askVol   Float    @default(0) // aggregated ask size in the bin (base units)

  @@index([symbol, exchange, t])
}

// Предагрегация снапшотов стакана в минутные бакеты × ценовой уровень. Пишется
// коллектором (накапливает снапшоты за минуту в памяти и сбрасывает завершённый
// бакет одним upsert). Источник для heatmap-сетки и панели B/A: вместо скана
// ~40М сырых строк ObSnapshot на каждый запрос читаем ~в 30 раз меньше строк.
// volSum/bidSum/askSum — суммы по всем снапшотам бакета на этом уровне; делитель
// (число снапшотов в бакете) хранится в ObRollupBucket. Прунится по ретеншну.
model ObSnapshotRollup {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало минутного бакета (UTC)
  price    Float // ценовой бин
  volSum   Float    @default(0) // Σ(bidVol+askVol) по снапшотам бакета
  bidSum   Float    @default(0) // Σ bidVol
  askSum   Float    @default(0) // Σ askVol
  // Индекса (symbol, exchange, bucket) здесь НЕТ намеренно: это точный префикс
  // первичного ключа, он не обслуживал ни одного запроса, а на сотнях млн строк
  // стоил гигабайты и замедлял вставку (миграция orderflow_index_diet).
  // По (bucket) индекс тоже не объявлен: для DELETE в pruneOld() достаточно
  // BRIN, а его Prisma описать не умеет — создаёт коллектор (ensureRollupIndexes).

  @@id([symbol, exchange, bucket, price])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

// Минутный rollup ленты сделок — то же, что ObSnapshotRollup для стакана.
// Дельта/CVD и «скорость ленты» читают его вместо сырого ObTrade: сырьё
// партиционировано по дням и на широком окне (до 800 свечей таймфрейма) даёт
// агрегацию по сотням тысяч строк на КАЖДЫЙ опрос, а фронт опрашивает
// orderflow каждые 3 секунды.
// Часовой и дневной уровни агрегации стакана — поверх минутного
// ObSnapshotRollup, НЕ вместо него: минутные данные остаются полными навсегда.
//
// Зачем: окно карты ордеров на старших таймфреймах — это месяцы и годы
// (1d = 365 дней), а колонок на графике всегда 240. На «1d» одна колонка
// шириной 36 часов, и складывать в неё 2160 минутных строк бессмысленно — тот
// же результат даёт одна дневная. Выбор уровня — по ширине колонки, см.
// rollupLevelFor() в lib/orderflow.ts.
//
// Ценовой бин НЕ огрубляется: за сутки цена проходит проценты, и уникальных
// бинов за день выходит сотни против сотен тысяч минутных строк — сжатие и так
// ~400×, а одинаковая сетка цен на всех уровнях избавляет чтение от разной
// логики биннинга.
model ObSnapshotRollupH {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало ЧАСА (UTC)
  price    Float
  volSum   Float    @default(0)
  bidSum   Float    @default(0)
  askSum   Float    @default(0)

  @@id([symbol, exchange, bucket, price])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

model ObSnapshotRollupD {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало СУТОК (UTC)
  price    Float
  volSum   Float    @default(0)
  bidSum   Float    @default(0)
  askSum   Float    @default(0)

  @@id([symbol, exchange, bucket, price])
  @@index([symbol, bucket])
}

// Счётчики снапшотов для тех же уровней: из них computeOrderflow берёт
// нормировку (число бирж / число снапшотов в колонке).
model ObRollupBucketH {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3)
  snaps    Int      @default(0)
  midSum   Float    @default(0)

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket])
}

model ObRollupBucketD {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3)
  snaps    Int      @default(0)
  midSum   Float    @default(0)

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket])
}

model ObTradeRollup {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало минутного бакета (UTC)
  buyVol   Float    @default(0) // Σ агрессивных покупок за минуту
  sellVol  Float    @default(0) // Σ агрессивных продаж
  trades   Int      @default(0) // Σ печатей (для скорости ленты)
  // (bucket) — BRIN, создаётся коллектором; см. ObSnapshotRollup.

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

// Часовой и дневной уровни ленты сделок — поверх минутного ObTradeRollup, по
// той же логике, что у стакана (ObSnapshotRollupH/D) и футпринта
// (ObFootprintRollupH). Минутный слой при этом остаётся полным.
//
// Зачем. Дельта и CVD рисуются на том же окне, что и карта: на 1d это 365
// суток, на 1w — около четырёх лет. Колонок на графике всегда 240, то есть на
// недельном таймфрейме одна колонка шире недели, а складывалась она из
// минутных строк. Замер на проде (pg_stat_statements): 1690 мс в среднем на
// вызов, 25.4 секунды суммарно за 8 часов — больше, чем все остальные запросы
// к этим таблицам вместе взятые. И это росло бы дальше: ROLLUP_RETENTION_DAYS
// по умолчанию 0, минутный слой ленты не чистится вовсе.
//
// Суммы при свёртке ассоциативны, поэтому дневной уровень строится из
// часового, а не из минутного — он уже в 60 раз меньше.
model ObTradeRollupH {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало ЧАСА (UTC)
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)
  trades   Int      @default(0)

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

model ObTradeRollupD {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало СУТОК (UTC)
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)
  trades   Int      @default(0)

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket])
}

// Rollup футпринта: объём покупок/продаж по ценовым уровням в ПЯТИМИНУТНОМ
// бакете. Пять минут — наименьший таймфрейм графика, а все остальные (15m, 1h,
// 4h, 12h, 1d, 1w) кратны ему, поэтому любой из них собирается из этих строк
// точно, без огрубления.
//
// Сырой ObFootprint пишется на каждый тик коллектора (≈1/с) на каждый ценовой
// уровень — на окне в 400–800 свечей это сотни тысяч строк, и раньше они
// сворачивались заново на КАЖДЫЙ опрос (фронт дёргает orderflow раз в 3 с).
model ObFootprintRollup {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало 5-минутного бакета (UTC)
  price    Float
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)
  // (symbol, exchange, bucket) — префикс PK, удалён; (bucket) — BRIN от коллектора.

  @@id([symbol, exchange, bucket, price])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

// Последний снапшот стакана — одна строка на (symbol, exchange). Профиль
// текущего стакана (столбик bid/ask справа от heatmap) читается по PK вместо
// поиска MAX(t) по сырому ObSnapshot: тот запрос выполнялся на КАЖДЫЙ опрос
// orderflow (раз в 3 с) и дважды сканировал окно — коррелированный подзапрос
// плюс внешняя выборка.
//
// levels — JSON [{ price, bidVol, askVol }] того же снапшота, что писался в
// ObSnapshot: уровни уже отфильтрованы порогом minCoins.
// Часовой уровень футпринта — поверх пятиминутного ObFootprintRollup, по той же
// логике, что и у стакана (см. ObSnapshotRollupH): на дневных и недельных
// свечах пятиминутные бакеты за окно шириной в год — это миллионы строк ради
// кластеров, которые всё равно схлопнутся в свечу.
model ObFootprintRollupH {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3) // начало ЧАСА (UTC)
  price    Float
  buyVol   Float    @default(0)
  sellVol  Float    @default(0)

  @@id([symbol, exchange, bucket, price])
  @@index([symbol, bucket])
}

model ObLatestBook {
  symbol   String
  exchange String
  t        DateTime @db.Timestamptz(3) // время снапшота
  mid      Float
  levels   Json

  @@id([symbol, exchange])
}

// Метаданные минутного бакета: сколько снапшотов в него попало (делитель для
// усреднения «высоты стен») и Σ mid (для B/A-зоны ±1%). Маленькая таблица —
// один ряд на (symbol,exchange,минута).
model ObRollupBucket {
  symbol   String
  exchange String
  bucket   DateTime @db.Timestamptz(3)
  snaps    Int      @default(0) // число снапшотов фида в бакете
  midSum   Float    @default(0) // Σ mid по снапшотам (avg mid = midSum/snaps)
  // (bucket) — BRIN, создаётся коллектором; см. ObSnapshotRollup.

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket]) // выборка по всем биржам (exchange="all")
}

// Editable collector settings (read by the collector every ~30s, edited in the
// admin panel — no redeploy). One row per symbol: minCoins = keep only limit
// levels whose resting size (bid+ask) is at least this many base coins. Bigger
// threshold = only large walls stored = far less data / disk.
model CollectorConfig {
  symbol     String // "BTCUSDT", "ETHUSDT", …
  market     String   @default("spot") // spot | futures — свой порог на каждый рынок
  minCoins   Float // minimum resting size (base coins) to record a level
  // «Отбирать всё»: писать ВСЕ уровни стакана без порога (minCoins игнорируется,
  // шумовой фильтр по нотионалу тоже). Внимание: объём данных сильно растёт.
  collectAll Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@id([symbol, market])
}

// Обращение в поддержку (тикет). Один вопрос = один тикет: пользователь создаёт
// новое обращение, переписывается внутри него, тикет закрывается (админом или
// самим пользователем) — следующий вопрос открывает НОВЫЙ тикет, а не продолжает
// старую переписку. Существовавшие до тикетов треды смигрированы в один
// legacy-тикет на пользователя (id = "legacy-<userId>").
model SupportTicket {
  id            String           @id @default(cuid())
  userId        String // владелец тикета (клиент)
  subject       String // тема: первая строка первого сообщения (обрезка)
  status        String           @default("open") // open | closed
  createdAt     DateTime         @default(now())
  closedAt      DateTime?
  lastMessageAt DateTime         @default(now()) // для сортировки инбокса
  messages      SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
}

// Сообщение внутри тикета — от юзера и от админа вперемешку. readAt = когда
// сообщение прочитано ДРУГОЙ стороной (юзерское читает админ, админское — юзер),
// так непрочитанные считаются раздельно для колокольчика админа и юзера.
model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String // владелец тикета (всегда клиент, даже для сообщений админа)
  authorRole String        @default("user") // "user" | "admin"
  email      String // снимок email автора сообщения на момент отправки
  message    String
  createdAt  DateTime      @default(now())
  readAt     DateTime? // NULL = непрочитано другой стороной

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
  @@index([authorRole, readAt])
}

// Серверные ошибки (500-е из API-роутов через serverError(), и необработанные
// исключения через Next.js instrumentation onRequestError). readAt = когда
// прочитано в админке (NULL = новое → бейдж на "Admin").
//
// Чистится ночным кроном /api/cron/analytics по ERRORLOG_RETENTION_DAYS
// (90 суток по умолчанию, см. lib/errorLog.ts). Раньше автоочистки не было, и
// таблица росла бессрочно — а пишет сюда не только serverError(), но и
// оповещения о посещаемости (lib/traffic/alerts.ts).
model ErrorLog {
  id        String    @id @default(cuid())
  message   String
  path      String? // маршрут, если известен (из onRequestError)
  stack     String? // усечённый стек, если известен
  createdAt DateTime  @default(now())
  readAt    DateTime? // NULL = новая, непрочитанная

  @@index([readAt, createdAt])
  @@index([createdAt])
}

// Кошелёк для донатов (кнопка «Донат» в меню пользователя). Редактируется в
// админ-панели: можно добавлять новые сети/адреса, отключать без удаления.
model DonateWallet {
  id        String   @id @default(cuid())
  network   String // отображаемое имя сети, напр. "TRC20 (Tron)"
  coin      String // напр. "USDT"
  address   String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) // порядок показа пользователю
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// Вкл/выкл биржи для синхронизации аккаунтов (тумблер в админ-панели). Нет
// строки → биржа считается включённой (дефолт). Влияет только на то, какие
// биржи пользователь может подключить; карты ордеров/ликвидаций не затрагивает.
model ExchangeToggle {
  exchange    String   @id // ccxt id: binance | bybit | okx | kraken | ...
  enabled     Boolean  @default(true)
  // Разрешён ли демо/testnet-счёт для этой биржи. NULL = взять статичный дефолт
  // (SUPPORTED_EXCHANGES[id].supportsDemo). Админ может переопределить.
  demoEnabled Boolean?
  updatedAt   DateTime @updatedAt
}

// deduped by canonical URL and refreshed lazily by the /api/news endpoint.
model NewsItem {
  id          String     @id @default(cuid())
  source      String // coindesk | cointelegraph | decrypt | forklog | beincrypto-ru | incrypted
  lang        String     @default("en") // en | ru — language of the article/headline
  title       String
  url         String     @unique
  summary     String?
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime   @default(now())
  image       NewsImage?

  @@index([lang, publishedAt])
  @@index([source])
}

// Обложка новости, сохранённая У НАС. Источники отдают картинки в исходном
// размере — от полумегабайта до полутора, — а показываем мы их плашкой в
// 80–112 px; одна такая обложка тянулась с чужого CDN дольше пятнадцати секунд
// и весила больше всей остальной страницы. Здесь лежит ужатый webp (~20 КБ),
// который отдаётся со своего сервера (см. /api/news/image/[id]).
//
// Отдельная таблица, а не колонка в NewsItem: Prisma в findMany без select
// тянет ВСЕ скалярные поля, и байты картинок ездили бы в память на каждом
// чтении ленты.
//
// onDelete: Cascade — обложка живёт ровно столько, сколько сама новость.
// Ретеншн (pruneOldNews) удаляет строки NewsItem, и картинки уходят вместе с
// ними на уровне БД, без отдельной уборки.
model NewsImage {
  newsId    String   @id
  news      NewsItem @relation(fields: [newsId], references: [id], onDelete: Cascade)
  data      Bytes // webp
  mime      String   @default("image/webp")
  width     Int
  bytes     Int // размер после сжатия — для диагностики в админке
  createdAt DateTime @default(now())
}

// Risk-manager limits. One row per user is the default profile (accountId = "");
// additional rows with a real accountId override the default for that account.
model RiskProfile {
  id             String   @id @default(cuid())
  userId         String
  accountId      String   @default("") // "" = default profile, else per-account override
  enabled        Boolean  @default(false)
  maxStopsPerDay Int? // max losing trades per day before "stop"
  // JSON: { day|week|month|year: { on: bool, value: number, unit: "pct"|"amount" } }
  lossLimits     String?
  // JSON: { on: bool, value: number, unit: "pct"|"amount" } — risk per trade (1R),
  // used to compute the risk-reward (R-multiple) column on trades.
  riskPerTrade   String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
}

// ─── Форекс (Dukascopy) ──────────────────────────────────────────────────
//
// Depth data from Dukascopy bridge: 10-level order book snapshots, minute
// rollups, and historical candles.

// Raw depth snapshot — price-bin level in the order book at a given instant.
// Written by the forex collector every FX_SNAPSHOT_MS ms.
model FxDepth {
  id       BigInt   @id @default(autoincrement())
  symbol   String // EUR/USD, GBP/USD, ...
  exchange String   @default("dukascopy")
  t        DateTime @db.Timestamptz(3)
  price    Float
  bidVol   Float    @default(0)
  askVol   Float    @default(0)

  @@index([symbol, t])
  @@index([symbol, exchange, t])
}

// OHLCV candles for forex pairs, fetched from Twelve Data time_series API.
model FxCandle {
  symbol   String // EUR/USD, GBP/USD, ...
  exchange String   @default("twelvedata")
  interval String // 5m, 15m, 1h, 4h, 12h, 1d, 1w
  t        DateTime @db.Timestamptz(3) // candle open time
  o        Float
  h        Float
  l        Float
  c        Float
  v        Float    @default(0) // volume

  @@id([symbol, exchange, interval, t])
  // Дубля PK нет — см. ObCandle (миграция candle_index_diet).
  // Коллектор проверяет глубину истории таймфрейма без привязки к символу.
  @@index([exchange, interval, t])
}

// Bid/ask quotes from Twelve Data quote API.
// Одна строка = один снапшот bid/ask для пары в момент времени.
// Используется для B/A spread, delta, CVD, imbalance.
model FxQuote {
  symbol   String // EUR/USD, GBP/USD, ...
  exchange String   @default("twelvedata")
  t        DateTime @db.Timestamptz(3) // quote timestamp
  bid      Float // bid price
  ask      Float // ask price
  mid      Float // (bid + ask) / 2
  spread   Float // ask - bid
  volume   Float    @default(0) // total volume (from quote)

  @@id([symbol, exchange, t])
  @@index([symbol, t])
  // (symbol, exchange, t) — точный дубль PK, снят (candle_index_diet).
}

// Список валютных пар, которые собирает forex-collector — управляется из
// админки без передеплоя (в отличие от ENV FX_SYMBOLS, который остаётся
// дефолтом/фоллбеком, если таблица пуста). Коллектор перечитывает эту
// таблицу раз в ~60с (тот же паттерн, что CollectorConfig для крипты).
model FxCollectorConfig {
  symbol    String   @id // "EUR/USD", "GBP/JPY", …
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Minute rollup aggregate of depth levels (parallel to ObSnapshotRollup).
model FxDepthRollup {
  symbol   String
  exchange String   @default("dukascopy")
  bucket   DateTime @db.Timestamptz(3) // minute bucket start
  price    Float
  volSum   Float    @default(0)
  bidSum   Float    @default(0)
  askSum   Float    @default(0)

  @@id([symbol, exchange, bucket, price])
  // (symbol, exchange, bucket) — точный ПРЕФИКС PK, снят (candle_index_diet).
  @@index([symbol, bucket])
}

// Metadata about a minute bucket: snapshot count and mid-price sum.
model FxRollupBucket {
  symbol    String
  exchange  String   @default("dukascopy")
  bucket    DateTime @db.Timestamptz(3)
  snapCount Int      @default(0)
  midSum    Float    @default(0)

  @@id([symbol, exchange, bucket])
  @@index([symbol, bucket])
}

// Economic-calendar event ingested from the free ForexFactory/faireconomy JSON
// feed. Global (not per-user); deduped by time+currency+title and refreshed
// lazily by the /api/econcal endpoint.
model EconomicEvent {
  id        String   @id @default(cuid())
  time      DateTime // event time (UTC)
  currency  String // USD, EUR, GBP ...
  country   String // United States, Euro Area ... (derived)
  title     String
  impact    String // high | medium | low | holiday
  category  String? // Employment | Inflation | Interest Rate ... (derived)
  forecast  String?
  previous  String?
  actual    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([time, currency, title])
  @@index([time])
}

// Generic on/off + tunable settings for optional features, editable from
// /admin/features (одна таблица под ВСЕ такие фичи — не заводим отдельную
// миграцию под каждый новый переключатель). key — стабильный идентификатор
// фичи в коде (см. src/lib/features.ts), config — JSON с параметрами
// конкретной фичи (batch size, лимиты и т.п.), поверх статичных дефолтов.
model FeatureConfig {
  key       String   @id
  enabled   Boolean  @default(true)
  config    String?
  updatedAt DateTime @updatedAt
}

model ImportLog {
  id        String   @id @default(uuid())
  module    String
  accountId String?
  eventType String
  message   String
  details   Json?
  level     String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([module])
  @@index([accountId])
  @@index([eventType])
}

// A named strategy/setup with its own written rules ("playbook") — extends
// the existing free-text `pattern` tag on TradeAnnotation with documentation
// and (computed on the fly, not stored) performance stats for that pattern.
// entryPoint optionally narrows the playbook to one specific ТВХ (entry point)
// value within that pattern — e.g. pattern "Breakout" has several distinct
// entry-point flavors ("retest", "impulse close", ...), each with its own
// rules. "" (default) means "any entry point" — the pattern-wide playbook.
model Playbook {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // matches a value in the user's patternOptions list
  entryPoint String   @default("") // matches a value in entryPointOptions; "" = any
  rules      String // free-form entry/exit/risk rules text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name, entryPoint])
  @@index([userId])
}

// A capability link ("Mentor Mode"): a read-only public snapshot of a user's
// aggregate stats, for sharing with a coach/mentor/accountability partner
// without giving them a login. `token` is the only credential — high-entropy,
// looked up directly (never enumerated), no separate user id in the URL.
model ShareLink {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String    @unique
  label        String? // e.g. "For my mentor"
  // Счёт, сделки которого показывает ссылка. NULL = все счета пользователя.
  // Намеренно без relation: счёт могут удалить, и такая ссылка должна отдавать
  // пустой список, а не превращаться молча в ссылку «на всё».
  accountId    String?
  // Период отбора сделок — конкретные даты из календаря. NULL с любой стороны
  // означает «без этой границы»; обе NULL — всё время.
  // periodTo хранится как начало следующих суток (см. миграцию): в календаре
  // выбирают день целиком, и сделка, закрытая вечером последнего дня, должна
  // попасть в выборку.
  periodFrom   DateTime?
  periodTo     DateTime?
  // Когда ссылка перестаёт открываться. NULL = бессрочная.
  // Хранится момент истечения, а не срок: так проверка — это сравнение с now(),
  // и срок не продлевается сам при каждом открытии.
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  reads     AnnouncementRead[]

  @@map("Announcement")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@map("AnnouncementRead")
}

// Дневные уровни + сетапы "пробой"/"ложный пробой", найденные скрипт-скан-ом
// по всем USDT-парам Binance spot (см. TRADE_RECOMMENDATIONS_PLAN.md). Не
// привязана к пользователю — общерыночные данные, одинаковые для всех.
// Пересчитывается ЦЕЛИКОМ раз в сутки (truncate + refill) — это "картина
// сегодняшнего дня", а не история, поэтому старых записей не копим.
// Отметка «фоновая задача отработала»: одна строка на job. Нужна, чтобы
// админка судила об авто-пересчёте по ФАКТУ прогонов, а не по переменной
// ENABLE_SCHEDULER: на самохостинге внутренний планировщик выключен намеренно,
// а пересчёт дёргает системный крон хоста — снаружи процесса app, и никакая
// env-переменная про него не знает.
model CronHeartbeat {
  job       String   @id // "recommendations.recompute"
  lastRunAt DateTime
  source    String // "scheduler" (внутренний планировщик) | "cron" (внешний крон хоста)

  @@map("CronHeartbeat")
}

model LevelSetup {
  id            String   @id @default(cuid())
  symbol        String
  exchange      String // "binance-spot"
  levelPrice    Float
  levelType     String // break_point | mirror | historical | parabar | gap | pullback_border | range_border | reworked
  strength      Int // число подтверждений/касаний уровня
  distanceAtr   Float // расстояние от текущей цены в долях ATR
  // Только для ЛП2Б: сколько завтрашнему бару пройти, чтобы вернуть цену за
  // уровень (в ATR). У остальных сетапов null — там «путь» считается от
  // distanceAtr, цена ещё не по другую сторону уровня.
  returnMoveAtr Float?
  bias          String // breakout | false_breakout | false_breakout_2b (нейтральные сетапы не сохраняются)
  direction     String // long | short — сторона сделки, следующая из bias и положения уровня к цене
  signals       Json // { for: string[], against: string[] } — какие факторы сработали
  bsuAt         DateTime // БСУ — бар, сформировавший уровень (док: «бар, сформировавший уровень»)
  quality       Json // метрики чистоты уровня из quality.ts (запилы, заражённость, запас хода)
  score         Float // ранг качества сетапа: по нему отбираются лучшие N инструментов
  atr           Float
  currentPrice  Float
  lastVolume    Float? // $-объём (base asset × цена закрытия) последнего закрытого дневного бара
  candlesFrom   DateTime // диапазон дневных свечей, использованный для расчёта/картинки
  candlesTo     DateTime
  createdAt     DateTime @default(now())

  @@index([symbol, exchange])
  @@index([bias])
  @@map("LevelSetup")
}

// ─── Посещаемость сайта (админ-раздел «Трафик») ──────────────────────────────
// Своя аналитика вместо Google Analytics/Plausible: проект самохостится, внешние
// счётчики (а) не видны из части стран аудитории, (б) режутся блокировщиками,
// (в) вообще не показывают роботов — а на публичном сайте это половина трафика.
// Сбор — на сервере (middleware → /api/analytics/collect), поэтому в статистику
// попадают и посетители с блокировщиками, и краулеры.
// Персональных данных нет: IP не хранится, только необратимый хэш внутри
// идентификатора посетителя (см. lib/traffic/hit.ts).

// Сырое событие: один просмотр страницы. Живёт ANALYTICS_RETENTION_DAYS суток
// (по умолчанию 90), дальше остаются только суточные агрегаты TrafficDaily.
model PageView {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  sessionId   String // визит (см. VisitSession)
  visitorId   String // посетитель: cookie ts_vid либо хэш IP+UA за сутки
  path        String // нормализованный путь: /share/[token], /admin/users/[id]
  isBot       Boolean  @default(false)
  botName     String? // "Googlebot", "GPTBot (OpenAI)", …
  botCategory String? // search | ai | seo | social | monitor | tool | scanner | other
  source      String // direct | search | social | referral | campaign | internal
  refHost     String? // хост источника или значение utm_source
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String // desktop | mobile | tablet | bot | unknown
  browser     String?
  os          String?
  lang        String?
  country     String?
  authed      Boolean  @default(false) // был ли валидный сеанс на момент запроса
  userId      String? // id пользователя, если он был авторизован
  nav         String   @default("load") // load — полная загрузка, spa — переход внутри приложения

  @@index([ts])
  @@index([isBot, ts])
  @@index([path, ts])
  @@index([sessionId])
  // Для подсчёта новых посетителей: «был ли этот visitorId раньше».
  @@index([visitorId, ts])
}

// Визит: цепочка просмотров одного посетителя без 30-минутных пауз. Отсюда
// берутся отказы (визит из одной страницы), глубина, длительность, страницы
// входа/выхода и конверсия в регистрацию.
model VisitSession {
  id          String   @id // = PageView.sessionId
  visitorId   String
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  views       Int      @default(0)
  entryPath   String
  exitPath    String
  isBot       Boolean  @default(false)
  botName     String?
  botCategory String?
  botReason   String? // на основании чего признан роботом (для отладки эвристик)
  // Маячок в браузере отработал → JS исполняется, это почти наверняка человек.
  jsConfirmed Boolean  @default(false)
  source      String
  refHost     String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String
  browser     String?
  os          String?
  lang        String?
  country     String?
  screen      String? // "1920x1080" — приходит от маячка
  userAgent   String?
  authed      Boolean  @default(false)
  userId      String?
  // Конверсии в рамках визита: регистрация / вход. Отвечает на главный вопрос
  // «сколько из зашедших дошли до аккаунта».
  registered  Boolean  @default(false)
  loggedIn    Boolean  @default(false)

  @@index([startedAt])
  @@index([isBot, startedAt])
  @@index([visitorId])
  @@index([lastSeenAt])
}

// Суточный агрегат для долгого хранения: сырые PageView чистятся, эти строки
// остаются. Универсальная форма scope/key, чтобы новые разрезы не требовали
// новой таблицы и миграции.
model TrafficDaily {
  day      DateTime @db.Date
  kind     String // human | bot
  scope    String // total | path | source | refHost | device | country | bot | entry
  key      String // "" для total, иначе значение разреза
  views    Int      @default(0)
  sessions Int      @default(0)
  visitors Int      @default(0)

  @@id([day, kind, scope, key])
  @@index([day])
}


// ─── Игра-симулятор: общий мир ─────────────────────────────────────────────
//
// Сама симуляция рынка живёт в браузере игрока (движок в src/engine, прогресс
// в IndexedDB) — на сервере лежит только ОБЩИЙ слой: кто есть кто, кто чего
// добился, кто кому должен и какие фонды собраны. Так игроки видят друг
// друга и соревнуются, а сервер не тикает симуляцию за каждого.
//
// Следствие, о котором нужно помнить: показатели присылает клиент, то есть
// теоретически их можно подделать. Поэтому (а) в рейтинге считаются
// достижения, которые дороже подделывать, чем заработать (пройденные
// испытания, ранг), (б) сервер режет неправдоподобные скачки при синхронизации
// (см. src/lib/game/world.ts), (в) деньги между игроками ходят только через
// записи GameLoan/GameFundEntry, которые ведёт сервер.

model GamePlayer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Публичное имя в мире игры. Отдельно от User.name: в игру человек может
  // захотеть зайти под псевдонимом, а почта и настоящее имя тут ни при чём.
  nickname        String   @unique
  fundName        String?
  rankKey         String   @default("retail")
  prestige        Int      @default(0)
  level           Int      @default(0)
  equity          Float    @default(0)
  peakEquity      Float    @default(0)
  contractsPassed Int      @default(0)
  bestContractPct Float    @default(0)
  activeStyle     String   @default("day")
  gameDay         Int      @default(0)
  // Репутация заёмщика: 100 у всех новых, падает за просрочку. Ниже порога
  // (см. lib/game/loans.ts) новые займы не выдаются.
  reliability     Int      @default(100)
  // Деньги, которые игроку должны вернуть, но он ещё не забрал их в игру
  // (проценты по выданным займам, выплаты фонда). Клиент забирает их при
  // следующей синхронизации и зачисляет на игровой баланс.
  pendingPayout   Float    @default(0)
  isPublic        Boolean  @default(true)
  // Сезон: в каком идёт зачёт и с какой эквити игрок в него вошёл. Считается
  // РОСТ от этой отметки, а не абсолютные деньги — иначе сезон выигрывал бы
  // тот, кто просто дольше играет.
  seasonId          String?
  season            GameSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonStartEquity Float?
  seasonResults     GameSeasonResult[]
  createdAt       DateTime @default(now())
  lastSyncAt      DateTime @default(now())

  fundId          String?
  fund            GameFund? @relation("fundMembers", fields: [fundId], references: [id])
  ownedFund       GameFund? @relation("fundOwner")
  loansGiven      GameLoan[] @relation("loanLender")
  loansTaken      GameLoan[] @relation("loanBorrower")
  fundEntries     GameFundEntry[]
  worldEvents     GameWorldEvent[]
  chatMessages    GameChatMessage[]
  strategies      GameStrategy[]
  strategyBuys    GameStrategyPurchase[]

  @@index([prestige])
  @@index([lastSyncAt])
}

model GameFund {
  id          String   @id @default(cuid())
  name        String   @unique
  motto       String?
  ownerId     String   @unique
  owner       GamePlayer @relation("fundOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Общий котёл: сумма взносов участников минус выплаты. Деньги приходят из
  // игровых балансов участников (клиент списывает у себя, сервер записывает).
  capital     Float    @default(0)
  // Доля прибыли, которую фонд удерживает при выплате (как у настоящих).
  feePct      Float    @default(20)
  createdAt   DateTime @default(now())
  members     GamePlayer[] @relation("fundMembers")
  entries     GameFundEntry[]

  @@index([capital])
}

model GameFundEntry {
  id        String   @id @default(cuid())
  fundId    String
  fund      GameFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  playerId  String
  player    GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // deposit — участник внёс, withdraw — забрал своё, payout — фонд выплатил долю прибыли.
  kind      String
  amount    Float
  createdAt DateTime @default(now())

  @@index([fundId, createdAt])
  @@index([playerId])
}

model GameLoan {
  id          String   @id @default(cuid())
  lenderId    String?
  lender      GamePlayer? @relation("loanLender", fields: [lenderId], references: [id], onDelete: SetNull)
  borrowerId  String
  borrower    GamePlayer  @relation("loanBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  amount      Float
  interestPct Float
  // Срок считается в ИГРОВЫХ днях заёмщика: у каждого своё игровое время, и
  // привязывать долг к реальным дням было бы нечестно — на investing игровой
  // месяц проходит за минуту.
  dueGameDay  Int
  // offered — предложение висит на бирже займов, active — деньги выданы,
  // repaid — возвращены, defaulted — просрочено.
  status      String   @default("offered")
  createdAt   DateTime @default(now())
  takenAt     DateTime?
  repaidAt    DateTime?

  @@index([status, createdAt])
  @@index([borrowerId])
  @@index([lenderId])
}

model GameWorldEvent {
  id        String   @id @default(cuid())
  playerId  String?
  player    GamePlayer? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // contract_passed | contract_failed | rank_up | fund_created | fund_joined |
  // loan_offered | loan_taken | loan_repaid | loan_defaulted | big_win
  kind      String
  // JSON с деталями события — из него собирается строка в ленте мира.
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}


// ─── Игра: общий рынок ─────────────────────────────────────────────────────
//
// Раньше рынок жил в браузере каждого игрока: у всех были свои цены, история
// умирала вместе с сохранением, а сравнивать результаты в общем мире было не
// с чем. Теперь рынок ОДИН на всех и лежит здесь.
//
// Как это устроено (подробно — src/lib/game/marketGen.ts): цены не хранятся
// «просто так», они ДЕТЕРМИНИРОВАННО выводятся из сида мира и номера бара.
// Одинаковые вход и номер бара всегда дают одинаковую цену, поэтому
// генерацию можно доганять кусками, в любом порядке и с любого сервера — и
// история не разъедется. В базе лежит результат: считать заново на каждый
// запрос было бы дорого.

model GameMarket {
  // Одна строка на мир. id фиксирован, чтобы не плодить вселенные.
  id          String   @id @default("world")
  seed        String
  // Начало истории: самая старая свеча, которую может увидеть игрок.
  startedAt   DateTime
  createdAt   DateTime @default(now())
}

model GameCandle {
  assetId String
  // Хранятся только "1h" и "1d" — костяк истории. Минутки НЕ хранятся: они
  // достраиваются внутри часа мостом Броуна (см. marketGen.bridgeMinutes),
  // который гарантированно приходит из открытия часа в его закрытие.
  // Поэтому минутный и часовой графики не могут разойтись, а база не растёт
  // на полмиллиона строк в сутки.
  tf      String
  ts      DateTime
  open    Float
  high    Float
  low     Float
  close   Float
  volume  Float

  @@id([assetId, tf, ts])
  @@index([assetId, tf, ts])
}

model GameMarketNews {
  id       String   @id @default(cuid())
  ts       DateTime
  // null в assetId — новость по всему рынку; sector — по отрасли.
  assetId  String?
  sector   String?
  impact   String
  headline String
  shockPct Float

  @@index([ts])
  @@index([assetId, ts])
}

// ─── Игра: разговоры и обмен стратегиями ───────────────────────────────────
//
// Мир, в котором игроки видят друг друга только в таблице рейтинга, — это
// ещё не мир. Здесь живут три вещи: общий чат, идея с графиком, приложенная
// к сообщению, и рынок стратегий.
//
// Идея с графиком возможна ровно потому, что рынок теперь ОБЩИЙ: приложив к
// сообщению инструмент, таймфрейм и свою разметку, игрок показывает
// собеседнику ровно то же, что видит сам. Раньше, когда цены считал каждый
// браузер, это не имело бы смысла.

model GameChatMessage {
  id        String   @id @default(cuid())
  // "general" — общий зал, "market" — разговоры про инструменты,
  // "fund:<id>" — закрытый канал фонда.
  channel   String
  playerId  String
  player    GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  text      String
  // Прикреплённая идея: инструмент, таймфрейм и разметка (JSON точек).
  assetId   String?
  tf        String?
  drawings  String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

// Сезоны: вечный рейтинг мёртв для новичка — пришедший через месяц не
// догонит первых никогда. Сезон считает только то, что сделано за его срок,
// и заканчивается: это и повод начать, и повод вернуться к дате. Общий
// прогресс (престиж, испытания, перки) сезон не трогает.
model GameSeason {
  id        String    @id @default(cuid())
  index     Int       @unique
  startedAt DateTime
  endsAt    DateTime
  // Проставляется, когда итоги подведены и награды разосланы.
  closedAt  DateTime?
  players   GamePlayer[]
  results   GameSeasonResult[]

  @@index([endsAt])
}

model GameSeasonResult {
  id        String   @id @default(cuid())
  seasonId  String
  season    GameSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId  String
  player    GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank      Int
  returnPct Float
  equity    Float
  reward    Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([seasonId, playerId])
  @@index([playerId])
}

model GameStrategy {
  id          String   @id @default(cuid())
  authorId    String
  author      GamePlayer @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Настройки алго-бота одной строкой JSON: правило входа, риск, стоп, тейк.
  config      String
  price       Float
  purchases   Int      @default(0)
  // Трек-рекорд: итоги бота АВТОРА по этой стратегии. Присылает клиент
  // автора вместе с синхронизацией мира. Пусто, пока бот не наторговал —
  // это честнее нуля, который читался бы как «стратегия убыточна».
  botId       String?
  trades      Int?
  winRate     Float?
  avgPnl      Float?
  reportedAt  DateTime?
  createdAt   DateTime @default(now())
  buyers      GameStrategyPurchase[]

  @@index([purchases])
  @@index([authorId])
}

model GameStrategyPurchase {
  id         String   @id @default(cuid())
  strategyId String
  strategy   GameStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      GamePlayer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  price      Float
  createdAt  DateTime @default(now())

  // Купить одну и ту же стратегию дважды нельзя — это копия правил, а не
  // расходник.
  @@unique([strategyId, buyerId])
  @@index([buyerId])
}
